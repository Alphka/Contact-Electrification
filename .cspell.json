{
	"$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
	"version": "0.2",
	"language": "en,pt-BR",
	"words": [
		"Alphka",
		"claude",
		"csstree",
		"darkreader",
		"ehthumbs",
		"eslintcache",
		"github",
		"isnan",
		"jetbrains",
		"mantine",
		"multilines",
		"ncurc",
		"nonconstructor",
		"nonoctal",
		"nonwords",
		"nosniff",
		"scannerwork",
		"sonarqube",
		"tailwindcss",
		"textnodes",
		"toastify",
		"triboelectric",
		"vercel",
		"yoda"
